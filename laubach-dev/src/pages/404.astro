---
import Base from "../layouts/Base.astro";
---
<Base title="Not found - laubach.dev" description="That page doesn't exist on laubach.dev.">
    <header class="page-head">
        <div class="wrap">
            <h1 class="page-title">Page not found</h1>
        </div>
    </header>
    <section>
        <div class="wrap">
            <p class="err">There's nothing at <span id="missing-path">this address</span>.</p>
            <p class="actions"><a class="btn primary" href="/">Home</a> <a href="/projects">Projects</a></p>
        </div>
    </section>
</Base>
<script>
    const el = document.querySelector<HTMLElement>("#missing-path");
    if (el && location.pathname) el.textContent = location.pathname;
</script>
<style>
    .err {
        color: var(--color-muted);
        overflow-wrap: anywhere;
    }
    .err span {
        color: var(--color-text);
    }
    .actions {
        margin-top: var(--space-6);
        display: flex;
        align-items: center;
        gap: 10px 20px;
        flex-wrap: wrap;
        font-size: var(--text-sm);
        font-weight: 500;
    }
</style>

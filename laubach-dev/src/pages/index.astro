---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SectionMarker from "../components/SectionMarker.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";

const featured = projects.filter((p) => p.featured);
const strengths = [
    { name: "Linux", text: "I use Arch Linux (EndeavourOS) every day and handle installs, configuration, and fixes from the command line." },
    { name: "Networking", text: "I helped build the networking lab at Sollers Point Technical High School: two interconnected networks, each with 6 switches and 6 routers. I handled most of the software and configuration." },
    { name: "Systems setup", text: "I built a forwarder that carries GPIB instrument traffic over a USB serial connection, and I run Python networking services on Linux that start on boot through systemd." },
    { name: "Deployment", text: "I took this site from buying the domain to DNS, HTTPS, and automatic deploys on Cloudflare." },
];
---
<Base title="laubach.dev" description="Austin Laubach, software engineering intern. I build command-line tools, web apps, and games. Strongest in Linux, networking, and setting up systems.">
    <Hero />

    <section id="strengths">
        <SectionMarker n="01" name="strengths" />
        <div class="man">
            {strengths.map((s) => (
                <article class="card"><h3>{s.name}</h3><p>{s.text}</p></article>
            ))}
        </div>
    </section>

    <section id="projects">
        <SectionMarker n="02" name="projects" />
        <div class="ls">
            {featured.map((p) => <ProjectCard project={p} />)}
        </div>
        <p class="more"><a class="btn" href="/projects">all projects</a></p>
    </section>

    <section id="about">
        <SectionMarker n="03" name="about" />
        <div class="about">
            <div>
                <p>I'm Austin Laubach. I was born and raised in Baltimore, Maryland, and I'm finishing a B.S. in Computer Science at UMBC, graduating in May 2027.</p>
                <p class="more"><a href="/about">more about me</a></p>
            </div>
            <dl>
                <dt>degree</dt><dd>B.S. Computer Science, UMBC, May 2027</dd>
                <dt>open to</dt><dd>full-time roles from May 2027</dd>
                <dt>location</dt><dd>Baltimore/DC area or remote</dd>
            </dl>
        </div>
    </section>

    <section id="contact">
        <SectionMarker n="04" name="contact" />
        <div class="contact">
            <div class="addr">hello@laubach.dev</div>
            <a class="btn primary" href="/contact">send a message</a>
        </div>
    </section>
</Base>
<style>
    .man {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-3);
    }
    .man article {
        padding: 20px 22px;
    }
    .man h3 {
        margin-bottom: 6px;
        font-family: var(--font-mono);
        font-size: var(--text-base);
        font-weight: 700;
    }
    .man p {
        color: var(--color-muted);
        font-size: var(--text-sm);
        max-width: 48ch;
    }
    .ls {
        display: grid;
        gap: var(--space-3);
    }
    .more {
        margin-top: var(--space-6);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
    }
    .about {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 40px;
    }
    .about p {
        max-width: 60ch;
    }
    .about .more {
        margin-top: 14px;
    }
    dl {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 10px 20px;
        align-content: start;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
    }
    dt {
        color: var(--color-muted);
    }
    dt::after {
        content: ":";
    }
    dd {
        margin: 0;
    }
    .contact {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-6);
        flex-wrap: wrap;
        border: 1px solid var(--color-rule);
        border-radius: var(--radius);
        padding: var(--space-6);
        background: var(--color-surface);
    }
    .addr {
        font-family: var(--font-mono);
        font-size: var(--text-xl);
        font-weight: 500;
        overflow-wrap: anywhere;
    }
    @media (max-width: 640px) {
        .man,
        .about {
            grid-template-columns: 1fr;
        }
        .about {
            gap: var(--space-6);
        }
        .addr {
            font-size: var(--text-lg);
        }
    }
</style>

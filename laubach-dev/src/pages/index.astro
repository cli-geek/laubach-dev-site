---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SectionHead from "../components/SectionHead.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";

const featured = projects.filter((p) => p.featured);
const strengths = [
    { name: "Linux", text: "I use Arch Linux (EndeavourOS) every day and handle installs, configuration and fixes from the command line. At work, I write Python networking scripts and packet forwarders for internal testing tools, designed to run at startup via systemd." },
    { name: "Networking", text: "I helped build the networking lab at Sollers Point Technical High School: two interconnected networks, each with 6 switches and 6 routers. I handled most of the software and configuration." },
    { name: "Embedded", text: "I write firmware for STM32 microcontrollers on new IoT devices and connect it to the UI and software above it. I work with the hardware team on PCB designs and BOMs so the pieces fit together." },
];
---
<Base title="laubach.dev" description="Austin Laubach, software engineering intern. I write firmware, desktop tools and web apps, and I'm strongest in Linux, networking and embedded systems.">
    <Hero />

    <section class="band" id="strengths">
        <div class="wrap">
            <SectionHead title="Strengths" />
            <div class="grid-3">
                {strengths.map((s) => (
                    <article class="card strength"><h3>{s.name}</h3><p>{s.text}</p></article>
                ))}
            </div>
        </div>
    </section>

    <section id="projects">
        <div class="wrap">
            <SectionHead title="Projects" href="/projects" linkLabel="All projects" />
            <div class="stack">
                {featured.map((p) => <ProjectCard project={p} />)}
            </div>
        </div>
    </section>

    <section class="band" id="about">
        <div class="wrap">
            <SectionHead title="About" />
            <div class="about">
                <div>
                    <p>Hi, I'm Austin Laubach. I was born and raised in Baltimore, Maryland. I'm currently finishing my B.S. in Computer Science at UMBC, with a prospective graduation in May 2027. I love cool things and working on them. I love reading sci-fi and fantasy, and I also love nature and going on hikes. My long-term goal is to work in biocomputing.</p>
                    <p class="more"><a href="/about">More about me</a></p>
                </div>
                <dl>
                    <dt>Degree</dt><dd>B.S. Computer Science, UMBC, May 2027</dd>
                    <dt>Location</dt><dd>Baltimore/DC area</dd>
                </dl>
            </div>
        </div>
    </section>

    <section id="contact">
        <div class="wrap">
            <SectionHead title="Contact" />
            <div class="contact">
                <div>
                    <a class="addr" href="mailto:hello@laubach.dev">hello@laubach.dev</a>
                    <p>Email me, or send a message through the contact form.</p>
                </div>
                <a class="btn secondary" href="/contact">Contact form</a>
            </div>
        </div>
    </section>
</Base>
<style>
    .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }
    .strength h3 {
        font-size: var(--text-md);
        font-weight: 600;
        margin-bottom: 6px;
    }
    .strength p {
        color: var(--color-muted);
        font-size: var(--text-sm);
    }
    .stack {
        display: grid;
        gap: 14px;
    }
    .about {
        display: grid;
        grid-template-columns: 1.3fr 1fr;
        gap: 32px;
        align-items: start;
    }
    .about p {
        max-width: 60ch;
    }
    .about .more {
        margin-top: var(--space-2);
        font-size: var(--text-sm);
        font-weight: 500;
    }
    .contact {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 12px 20px;
    }
    .contact p {
        color: var(--color-muted);
        font-size: var(--text-sm);
    }
    .addr {
        font-size: var(--text-lg);
        font-weight: 600;
        overflow-wrap: anywhere;
    }
    @media (max-width: 760px) {
        .grid-3,
        .about {
            grid-template-columns: 1fr;
        }
        .about {
            gap: var(--space-4);
        }
    }
</style>

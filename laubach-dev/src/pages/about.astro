---
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";

const experience = [
    {
        role: "Software Engineering Intern",
        org: "Woodsong Technologies",
        place: "Annapolis Junction, MD",
        dates: "Jun 2026 – present",
        points: [
            "Write STM32 firmware for IoT devices, working with the hardware team around their PCB designs and BOMs.",
            "Primary developer of the user interfaces that operate and configure these devices, like a React telemetry dashboard, as well as of the communication layer and network code that connects the firmware to the UI.",
            "Build Python networking services on Linux that start at boot through systemd.",
            "The proclaimed 'Linux-man' of the office",
        ],
    },
    {
        role: "Print & Marketing Associate",
        org: "Staples",
        place: "Baltimore, MD",
        dates: "Sep 2022 – Jun 2026",
        points: [],
    },
    {
        role: "Entry Level PC Technician (contract)",
        org: "Data Networks",
        place: "Baltimore, MD",
        dates: "Jun – Aug 2021",
        points: ["Configured 25+ Juniper switches a day for enterprise deployments."],
    },
];

const skills = [
    { group: "Languages", items: ["C", "C++", "Rust", "Python", "JavaScript", "Swift", "GDScript", "Bash", "x86 assembly", "RISC-V assembly"] },
    { group: "Embedded", items: ["STM32", "microcontrollers", "firmware"] },
    { group: "Web", items: ["React", "HTML", "CSS", "REST APIs"] },
    { group: "Systems and networking", items: ["Linux", "Git", "systemd", "Cisco networking", "Juniper networking", "system imaging"] },
    { group: "Tools", items: ["Godot", "SQLite", "Pandas", "Flask"] },
];
---
<Base title="About - laubach.dev" description="About Austin Laubach: UMBC computer science student graduating May 2027, experience and skills.">
    <header class="page-head">
        <div class="wrap">
            <h1 class="page-title">About</h1>
        </div>
    </header>

    <section id="bio">
        <div class="wrap">
            <div class="intro-grid">
                <div class="bio">
                    <p class="lead">Hi, I'm Austin Laubach. I was born and raised in Baltimore, Maryland. I'm currently finishing my B.S. in Computer Science at UMBC, with a prospective graduation in May 2027. I love cool things and working on them. I love reading sci-fi and fantasy, and I also love nature and going on hikes. My long-term goal is to work in biocomputing, restoring functions to those who've lost them.</p>
                    <p>Most of my work right now is close to the hardware. At my internship I write <strong>STM32 firmware</strong> and the software that connects it to the user interface.</p>
                    <p>Outside of work I build tools for problems I run into: <strong>gantry, a job-search app written in Rust</strong>, and simple tools too, like <strong>batt-buddy, a macOS battery indicator written in Swift.</strong> I also helped build <strong>SPHERExplorer, a NASA image explorer</strong>, with a teammate for the 2026 Space Apps Challenge, <strong>where we placed first in the local competition</strong>.</p>
                    <p>I'd also like to do more with video games. I love playing them, and I enjoy making them, as well as all of the fun (and not-so-fun) math that comes with that.</p>
                    <p class="actions"><a class="btn secondary" href="/resume.pdf">Résumé (PDF)</a></p>
                </div>
                <dl class="facts card">
                    <dt>Based in</dt><dd>Baltimore/DC area</dd>
                    <dt>Studying</dt><dd>B.S. Computer Science, UMBC</dd>
                    <dt>Graduating</dt><dd>May 2027</dd>
                </dl>
            </div>
        </div>
    </section>

    <section class="band" id="education">
        <div class="wrap">
            <SectionHead title="Education" />
            <article class="card entry">
                <div class="entry-head">
                    <h3>University of Maryland, Baltimore County</h3>
                    <span class="when">May 2027 (expected)</span>
                </div>
                <p class="muted">B.S. Computer Science · Baltimore, MD</p>
            </article>
        </div>
    </section>

    <section id="experience">
        <div class="wrap">
            <SectionHead title="Experience" />
            <div class="stack">
                {experience.map((e) => (
                    <article class="card entry">
                        <div class="entry-head">
                            <h3>{e.role}</h3>
                            <span class="when">{e.dates}</span>
                        </div>
                        <p class="muted">{e.org} · {e.place}</p>
                        {e.points.length > 0 && (
                            <ul class="desc">
                                {e.points.map((p) => <li>{p}</li>)}
                            </ul>
                        )}
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="band" id="skills">
        <div class="wrap">
            <SectionHead title="Skills" />
            <div class="card">
                <dl class="skills">
                    {skills.map((s) => (
                        <>
                            <dt>{s.group}</dt>
                            <dd>{s.items.join(", ")}</dd>
                        </>
                    ))}
                </dl>
            </div>
        </div>
    </section>
</Base>
<style>
    h3 {
        font-size: var(--text-md);
        font-weight: 600;
    }
    strong {
        color: var(--color-text);
        font-weight: 500;
    }

    /* bio beside a quick-facts panel */
    .intro-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
        gap: 32px;
        align-items: start;
    }
    .bio {
        display: grid;
        gap: var(--space-3);
    }
    .bio p {
        max-width: 60ch;
    }
    .lead {
        font-size: var(--text-md);
    }
    .bio p:not(.lead):not(.actions) {
        color: var(--color-muted);
    }
    .actions {
        margin-top: var(--space-1);
    }
    .facts {
        align-content: start;
    }

    .stack {
        display: grid;
        gap: 14px;
    }
    .entry {
        display: grid;
        gap: 6px;
    }
    .entry-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 2px 12px;
    }
    .when {
        margin-left: auto;
        font-size: var(--text-xs);
        color: var(--color-muted);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }
    .muted {
        color: var(--color-muted);
        font-size: var(--text-sm);
    }
    /* one thought per line, same bullets as project cards */
    .desc {
        list-style: disc;
        padding-left: 1.1em;
        margin-top: var(--space-2);
        display: grid;
        gap: var(--space-1);
        font-size: var(--text-sm);
        max-width: 70ch;
    }

    .skills {
        gap: 10px 20px;
    }
    .skills dt {
        font-weight: 500;
        color: var(--color-text);
    }

    @media (max-width: 760px) {
        .intro-grid {
            grid-template-columns: 1fr;
            gap: var(--space-4);
        }
    }
    @media (max-width: 480px) {
        .when {
            margin-left: 0;
            width: 100%;
        }
        .skills {
            grid-template-columns: 1fr;
            gap: 2px;
        }
        .skills dd {
            margin-bottom: var(--space-2);
        }
    }
</style>

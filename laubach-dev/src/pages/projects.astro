---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---
<Base title="Projects - laubach.dev" description="Projects by Austin Laubach: SPHERExplorer, gantry, and more.">
    <header class="page-head">
        <div class="wrap">
            <h1 class="page-title">Projects</h1>
        </div>
    </header>
    <section>
        <div class="wrap">
            <div class="stack">
                {projects.map((p) => <ProjectCard project={p} />)}
            </div>
        </div>
    </section>
</Base>
<style>
    .stack {
        display: grid;
        gap: 14px;
    }
</style>

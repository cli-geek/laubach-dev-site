---
import type { Project } from "../data/projects";

interface Props {
    project: Project;
}
const { project } = Astro.props;
const status = project.status && project.status.charAt(0).toUpperCase() + project.status.slice(1);
---
<article class="project card">
    <header class="head">
        <h3>{project.name}</h3>
        <span class="date">{project.date}</span>
    </header>
    {status && <p class="status">{status}</p>}
    {project.note && <p class="note">{project.note}</p>}

    <p class="summary">{project.summary}</p>

    <ul class="points">
        {project.points.map((p) => <li>{p}</li>)}
    </ul>

    {project.credit && <p class="credit">{project.credit}</p>}

    <footer class="foot">
        <span class="tech">{project.tech.join(" · ")}</span>
        {project.links.length > 0 && (
            <ul class="links">
                {project.links.map((l) => (
                    <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a></li>
                ))}
            </ul>
        )}
    </footer>
</article>
<style>
    .project {
        display: grid;
        gap: var(--space-2);
    }

    .head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 2px 12px;
    }
    h3 {
        font-size: var(--text-md);
        font-weight: 600;
    }
    .date {
        margin-left: auto;
        font-size: var(--text-xs);
        color: var(--color-muted);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    /* sits directly under the name, so pull it up against the grid gap */
    .status {
        margin-top: calc(-1 * var(--space-2));
        font-size: var(--text-xs);
        color: var(--color-muted);
    }
    .summary {
        max-width: 70ch;
    }
    .points {
        list-style: disc;
        padding-left: 1.1em;
        display: grid;
        gap: var(--space-1);
        color: var(--color-muted);
        font-size: var(--text-sm);
        max-width: 70ch;
    }
    /* an award or callout, directly under the name like the status line */
    .note {
        margin-top: calc(-1 * var(--space-2));
        color: var(--color-accent);
        font-size: var(--text-sm);
        font-weight: 500;
    }
    .credit {
        font-size: var(--text-xs);
        color: var(--color-muted);
    }

    .foot {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 4px 16px;
        margin-top: var(--space-1);
        font-size: var(--text-xs);
    }
    .tech {
        color: var(--color-muted);
    }
    .links {
        display: flex;
        gap: 16px;
        font-size: var(--text-sm);
        font-weight: 500;
    }

    @media (max-width: 480px) {
        .date {
            margin-left: 0;
            width: 100%;
        }
    }
</style>

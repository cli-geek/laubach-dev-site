---
import type { Project } from "../data/projects";

interface Props {
    project: Project;
}
const { project } = Astro.props;
---
<article class="project card">
    <header class="head">
        <h3>{project.name}</h3>
        {project.status && <span class="status"><span class="dot" aria-hidden="true"></span>{project.status}</span>}
        <span class="date">{project.date}</span>
    </header>

    <p class="summary">{project.summary}</p>

    {project.note && <p class="note">{project.note}</p>}

    <ul class="points">
        {project.points.map((p) => <li>{p}</li>)}
    </ul>

    {project.credit && <p class="credit">{project.credit}</p>}

    <footer class="foot">
        <ul class="tags" aria-label="Tech">
            {project.tech.map((t) => <li class="tag">{t}</li>)}
        </ul>
        {project.links.length > 0 && (
            <ul class="links">
                {project.links.map((l) => (
                    <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label} <span aria-hidden="true">↗</span></a></li>
                ))}
            </ul>
        )}
    </footer>
</article>
<style>
    .project {
        display: grid;
        gap: var(--space-3);
        padding: 22px 24px;
    }
    ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .head {
        display: flex;
        align-items: baseline;
        gap: var(--space-3);
        flex-wrap: wrap;
    }
    h3 {
        font-family: var(--font-mono);
        font-size: var(--text-lg);
        font-weight: 700;
        letter-spacing: -0.01em;
    }
    .status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-ok);
        border: 1px solid color-mix(in srgb, var(--color-ok) 40%, var(--color-rule));
        border-radius: 999px;
        padding: 0 10px;
    }
    .status .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--color-ok);
    }
    .date {
        margin-left: auto;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-muted);
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .summary {
        color: var(--color-text);
        max-width: 62ch;
    }
    .note {
        justify-self: start;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-accent);
        background: color-mix(in srgb, var(--color-accent) 10%, transparent);
        border: 1px solid color-mix(in srgb, var(--color-accent) 35%, var(--color-rule));
        border-radius: 3px;
        padding: 3px 10px;
    }
    .points {
        display: grid;
        gap: 6px;
        font-size: var(--text-sm);
        color: var(--color-muted);
        max-width: 62ch;
    }
    .points li {
        display: grid;
        grid-template-columns: 1.1em 1fr;
    }
    .points li::before {
        content: "›";
        color: var(--color-accent);
        font-family: var(--font-mono);
        font-weight: 700;
    }
    .credit {
        font-size: var(--text-xs);
        color: var(--color-muted);
        font-style: italic;
    }

    .foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-3);
        flex-wrap: wrap;
        margin-top: var(--space-1);
        padding-top: var(--space-3);
        border-top: 1px solid var(--color-rule);
    }
    .tags,
    .links {
        display: flex;
        flex-wrap: wrap;
    }
    .tags {
        gap: 6px;
    }
    .tag {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-accent);
        border: 1px solid var(--color-rule);
        padding: 1px 8px;
        border-radius: 2px;
    }
    .links {
        gap: var(--space-4);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
    }
</style>

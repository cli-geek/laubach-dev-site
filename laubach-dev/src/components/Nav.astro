---
const currentPath = Astro.url.pathname;
---
<nav aria-label="Primary">
    <div class="wrap container">
        <a class="wordmark" href="/" aria-current={currentPath === "/" ? "page" : undefined}><b>[</b> laubach.dev <b>]</b></a>
        <ul class="states-container">
            <li><a class="state-link" href="/projects" aria-current={currentPath === "/projects" ? "page" : undefined}>Projects</a></li>
            <li><a class="state-link" href="/about" aria-current={currentPath === "/about" ? "page" : undefined}>About</a></li>
            <li><a class="state-link" href="/contact" aria-current={currentPath === "/contact" ? "page" : undefined}>Contact</a></li>
        </ul>
    </div>
</nav>
<style>
    nav {
        border-bottom: 1px solid var(--color-rule);
    }

    .container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px 24px;
        padding-block: 12px;
    }

    .wordmark {
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: var(--text-md);
        color: var(--color-text);
        white-space: nowrap;
    }

    .wordmark:hover {
        text-decoration: none;
    }

    .wordmark b {
        color: var(--color-accent);
        font-weight: 700;
    }

    .states-container {
        display: flex;
        gap: 24px;
        font-size: var(--text-sm);
        font-weight: 500;
    }

    .states-container a {
        color: var(--color-muted);
    }

    .states-container a:hover {
        color: var(--color-text);
        text-decoration: none;
    }

    .states-container a[aria-current="page"] {
        color: var(--color-text);
        text-decoration: underline;
        text-decoration-color: var(--color-accent);
        text-decoration-thickness: 2px;
        text-underline-offset: 6px;
    }

    /* mobile styles */
    @media (max-width: 480px) {
        .states-container {
            gap: var(--space-4);
        }
    }
</style>

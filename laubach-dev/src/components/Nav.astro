---
const currentPath = Astro.url.pathname;
---
<nav aria-label="Primary">
    <div class="container">
        <a class="wordmark" href="/" aria-current={currentPath === "/" ? "page" : undefined}><b>[</b> laubach.dev <b>]</b></a>
        <ul class="states-container">
            <li><a class="state-link" href="/projects" aria-current={currentPath === "/projects" ? "page" : undefined}>projects</a></li>
            <li><a class="state-link" href="/about" aria-current={currentPath === "/about" ? "page" : undefined}>about</a></li>
            <li><a class="state-link" href="/contact" aria-current={currentPath === "/contact" ? "page" : undefined}>contact</a></li>
        </ul>
    </div>
</nav>
<style>
    nav {
        position: sticky;
        top: env(safe-area-inset-top, 0px);
        z-index: 10;

        background: color-mix(in srgb, var(--color-bg) 88%, transparent);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--color-rule);
    }

    .container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-4);

        max-width: var(--max-width-wide);
        margin-inline: auto;
        padding: 14px var(--gutter);
    }

    .wordmark {
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: var(--text-lg);
        color: var(--color-text);
        white-space: nowrap;
    }

    .wordmark b {
        color: var(--color-accent);
        font-weight: 700;
    }

    .states-container {
        display: flex;
        align-items: center;
        list-style: none;
        padding: 0;
        gap: 28px;

        font-family: var(--font-mono);
        font-size: var(--text-sm);
    }

    .states-container a {
        color: var(--color-muted);
        transition: color 0.15s ease;
    }

    .states-container a:hover {
        color: var(--color-text);
        text-decoration: none;
    }

    .states-container a[aria-current="page"] {
        color: var(--color-text);
    }

    .states-container a[aria-current="page"]::before {
        content: "./";
        color: var(--color-accent);
    }

    /* mobile styles */
    @media (max-width: 480px) {
        .wordmark {
            font-size: var(--text-base);
        }
        .states-container {
            gap: var(--space-4);
        }
    }
</style>

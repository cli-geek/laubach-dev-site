---
const year = new Date().getFullYear();
---
<footer>
    <div class="wrap footer-container">
        <span>© {year} Austin Laubach</span>
        <ul class="links-container">
            <li><a href="https://github.com/cli-geek" target="_blank" rel="noopener noreferrer">GitHub</a></li>
            <li><a href="https://www.linkedin.com/in/austinlaubach/" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
            <li><a href="/contact">Contact</a></li>
        </ul>
    </div>
</footer>
<style>
    footer {
        border-top: 1px solid var(--color-rule);
    }

    .footer-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px 24px;
        padding-block: 16px;

        font-size: var(--text-xs);
        color: var(--color-muted);
    }

    .links-container {
        display: flex;
        gap: 18px;
    }

    .links-container a {
        color: var(--color-muted);
    }

    .links-container a:hover {
        color: var(--color-text);
    }
</style>
